Incorrect

const arr = [];
      ~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `arr: Type[] = []` instead.
const items = [];
      ~~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `items: Type[] = []` instead.
let data = [];
    ~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `data: Type[] = []` instead.
var list = [];
    ~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `list: Type[] = []` instead.
const more = new Array();
      ~~~~~~~~~~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `more: Type[] = new Array()` or `more: Type[] = []` instead.
const extra = Array();
      ~~~~~~~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `extra: Type[] = new Array()` or `extra: Type[] = []` instead.

class Foo {
  items = [];
  ~~~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `items: Type[] = []` instead.
  data = new Array();
  ~~~~~~~~~~~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `data: Type[] = new Array()` or `data: Type[] = []` instead.
}

const obj = {
  items: [],
  ~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `items: [] as Type[]` instead.
  data: new Array(),
  ~~~~~~~~~~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `data: new Array<Type>()` or `data: [] as Type[]` instead.
};

Correct

const arr: string[] = [];
const items: number[] = [];
let data: boolean[] = [];
var list: any[] = [];
const more: string[] = new Array();
const extra = new Array<string>();

class Foo {
  items: string[] = [];
  data: number[] = new Array();
}

const obj = {
  items: [] as string[],
  data: new Array<number>(),
};

// If you intentionally want never[], you can be explicit about it
const placeholder: never[] = [];

// Non-empty arrays don't require explicit types
const numbers = [1, 2, 3];
const strings = ['a', 'b'];

// Type assertions are also acceptable
const typedArr = [] as string[];
const typedItems = [] as number[];

interface Config {
  plugins: string[];
}

// Contextually-typed empty arrays are accepted — the element type is already known
const config: Config = { plugins: [] };
function make(): { items: string[] } {
  return { items: [] };
}
const listItems: { items: string[] }[] = [{ items: [] }];
const sat = { items: [] } satisfies { items: string[] };

Incorrect
Options: { "ignoreMutableVariables": true }

const arr = [];
      ~~~~~~~~ Empty array should have an explicit type annotation for code clarity. Use `arr: Type[] = []` instead.

Correct
Options: { "ignoreMutableVariables": true }

let arr = [];
var list = [];
const typed: string[] = [];
